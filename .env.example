# === BOT ===
BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === ADMIN ===
# Vergul bilan bir nechta admin Telegram ID kiritish mumkin
ADMIN_IDS=123456789
ADMIN_PHONE=+998935959355

# === KINO SAQLANADIGAN YOPIQ KANAL ===
# Bot shu kanalda ADMIN bo'lishi SHART
STORAGE_CHANNEL_ID=-1001234567890

# === MAJBURIY OBUNA KANALLARI ===
# Format: username1,username2 (@ belgisisiz) - bo'sh bo'lsa obuna tekshirilmaydi
REQUIRED_CHANNELS=mychannel1,mychannel2

# === DATABASE ===
# To'g'ridan-to'g'ri PostgreSQL'ga ham, PgBouncer orqali ham ulanish mumkin —
# ilova buni bilmaydi ham, farqi yo'q ham (faqat host/port o'zgaradi).
# 100K+ auditoriya + bir nechta bot instansida PgBouncer TAVSIYA ETILADI
# (har instans o'z pool'ini ochadi — PgBouncer bo'lmasa PostgreSQL'ning
# max_connections'iga tez tegib qoladi).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kinobot
POSTGRES_USER=kinobot
POSTGRES_PASSWORD=change_me_strong_password
# Connection pool (ko'p auditoriyada standart qiymatlar kam bo'lishi mumkin).
# Sig'im hisobi: (DB_POOL_SIZE + DB_MAX_OVERFLOW) x instanslar soni <
# PostgreSQL max_connections (yoki PgBouncer pool_size).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SEC=1800
DB_POOL_TIMEOUT_SEC=10

# === REDIS ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_MAX_CONNECTIONS=50

# === APP ===
DEFAULT_LANGUAGE=uz
TREND_LIMIT=10
SEARCH_SIMILARITY_THRESHOLD=0.2
RATE_LIMIT_PER_MINUTE=20
# copy_message da protect_content (video ko'chirishni cheklash)
PROTECT_CONTENT=true

# === REKLAMA ===
# Har bir yuborilgan kino ostida 2 ta tugma chiqadi: botga va kanalga havola
# (@ belgisisiz, username)
PROMO_BOT_USERNAME=SpoylerBot
PROMO_CHANNEL_USERNAME=spoylerkino

# === ISHGA TUSHIRISH REJIMI ===
# production: Redis ishlamasa bot ISHGA TUSHMAYDI (FSM/pool xavfsizligi
# uchun majburiy). development: Redis bo'lmasa MemoryStorage'ga tushadi.
BOT_ENV=production
# polling (bitta instans, standart) yoki webhook (bir nechta instans +
# reverse proxy uchun; WEBHOOK_URL/WEBHOOK_SECRET talab qiladi).
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=
# Health-check (/health/live, /health/ready) va Prometheus (/metrics)
# HTTP serveri porti.
HTTP_PORT=8080

# === MONITORING (ixtiyoriy) ===
# Bo'sh qoldirilsa Sentry yoqilmaydi. To'ldirilsa `pip install sentry-sdk`
# ham kerak (standart requirements.txt'da yo'q — majburiy emas).
SENTRY_DSN=
